{
  "name": "math-knowledge",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3002 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 3002 --strictPort",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "index:wikipedia": "node --experimental-strip-types scripts/build-wikipedia.mjs",
    "index:learning": "node --experimental-strip-types scripts/build-learning-index.mjs",
    "index:descriptions": "node scripts/refresh-descriptions.mjs",
    "index:lists": "node scripts/build-list-index.mjs"
  },
  "dependencies": {
    "@types/katex": "0.16.8",
    "katex": "0.19.1",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "description": "A knowledge graph of mathematics based on Wikipedia, with interactive branching concepts, formulas, and source notes.",
  "homepage": "https://math-knowledge.org",
  "repository": {
    "type": "git",
    "url": "https://github.com/itsalissonsilva/math-knowledge.git"
  }
}
